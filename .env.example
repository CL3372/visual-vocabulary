# Copy this file to .env and fill in your values

# Pexels API key — get one free at https://www.pexels.com/api/
VITE_PEXELS_API_KEY=

# Stripe Payment Links — create at https://dashboard.stripe.com/payment-links
# Used on the WEB build only. The iOS app must not sell subscriptions this
# way (App Store Guideline 3.1.1) — see VITE_REVENUECAT_IOS_API_KEY below.
VITE_STRIPE_PAYMENT_LINK=
VITE_STRIPE_ANNUAL_LINK=

# RevenueCat public SDK key for the iOS app — get from
# https://app.revenuecat.com > Project Settings > API Keys (use the "Apple
# App Store" public key, not a secret key). Powers native In-App Purchase
# for the Pro subscription on iOS. Leave blank on web builds; it's unused
# there.
VITE_REVENUECAT_IOS_API_KEY=

# Google Analytics 4 — get from https://analytics.google.com (format: G-XXXXXXXXXX)
# Leave blank to disable analytics
VITE_GA_ID=
